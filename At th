local function UpdateESP()
    local anyEspActive = (
        Config.ESP_Name or Config.ESP_Health or Config.ESP_Distance or
        Config.ESP_Team or Config.ESP_Level or Config.ESP_Bounty or
        Config.ESP_KenActive or Config.ESP_PvpState
    )

    if not anyEspActive then
        for _, gui in pairs(State.ESPObjects) do
            gui.Enabled = false
        end
        return
    end

    local myHrp = GetRootPart(LocalPlayer)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = GetCharacter(plr)
            local head = char and char:FindFirstChild("Head")
            local hum  = GetHumanoid(plr)
            local hrp  = GetRootPart(plr)

            if char and head and hum and hrp and hum.Health > 0 then
                local bGui = State.ESPObjects[plr.UserId]
