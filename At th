local CamLockBtn, CamLockStroke = CreateFixedQuickBtn(
    "CameraLockButton",
    "Camera Lock",
    0,
    function(btn, stroke)
        Config.CameraLock = not Config.CameraLock
        if Config.CameraLock then
            State.LockedTarget = GetBestTarget()
            stroke.Color = Theme.HudRedText
            stroke.Transparency = 0
            btn.TextColor3 = Color3.fromRGB(255, 215, 55)
            Notify("Camera Lock", State.LockedTarget and ("Locked: " .. State.LockedTarget.Name) or "Camera Lock ON", 2)
        else
            State.LockedTarget = nil
            stroke.Color = Color3.fromRGB(52, 55, 64)
            stroke.Transparency = 0.25
            btn.TextColor3 = Theme.HudRedText
            Notify("Camera Lock", "Camera Lock OFF", 2)
        end
    end
)

local TPTargetBtn, TPTargetStroke = CreateFixedQuickBtn(
    "TPToTargetButton",
    "TP To Target",
    28,
    function(_, stroke)
        local target = State.LockedTarget or State.CurrentTarget or GetBestTarget()
        if target and IsPlayerAlive(target) then
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp  = GetRootPart(target)
            if myHrp and tHrp then
                stroke.Color = Theme.CheckboxOn
                TryPortalBypass(tHrp.Position)
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
                task.delay(0.25, function()
                    stroke.Color = Color3.fromRGB(52, 55, 64)
                end)
            end
        else
            Notify("TP To Target", "No valid PvP target nearby", 2)
        end
    end
)

if Config.CameraLock then
