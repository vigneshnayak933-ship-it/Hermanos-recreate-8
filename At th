-- Checks if local player is holding or casting any skill (Keyboard OR Mobile Touch / Busy / BodyGyro)
local function IsUsingOrHoldingSkill()
    if UserInputService:IsKeyDown(Enum.KeyCode.Z) or
       UserInputService:IsKeyDown(Enum.KeyCode.X) or
       UserInputService:IsKeyDown(Enum.KeyCode.C) or
       UserInputService:IsKeyDown(Enum.KeyCode.V) or
       UserInputService:IsKeyDown(Enum.KeyCode.F) then
        return true
    end
