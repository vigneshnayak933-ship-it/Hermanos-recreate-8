local CachedCombatController = nil
local LastCombatControllerScan = 0

local function GetCombatActiveController()
    if CachedCombatController and (os.clock() - LastCombatControllerScan < 4) then
        return CachedCombatController
    end
    LastCombatControllerScan = os.clock()

    pcall(function()
        local cfModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        if cfModule and debug and debug.getupvalues then
            local ok, cfTable = pcall(require, cfModule)
            if ok and cfTable then
                for _, up in pairs(debug.getupvalues(cfTable)) do
                    if type(up) == "table" and up.activeController then
                        CachedCombatController = up.activeController
                        return
                    end
                end
            end
        end
    end)
    if CachedCombatController then return CachedCombatController end

    pcall(function()
        for _, fn in pairs(getgc()) do
            if type(fn) == "function" and debug and debug.getupvalues then
                local ok, ups = pcall(debug.getupvalues, fn)
                if ok and ups then
                    for _, upVal in pairs(ups) do
                        if type(upVal) == "table" and rawget(upVal, "activeController") then
                            CachedCombatController = rawget(upVal, "activeController")
                            return
                        end
                    end
                end
            end
        end
    end)

    return CachedCombatController
end

local function ExecuteFastAttack(targetPlr)
    -- Automatically pause AttackAura M1 swings whenever you hold or cast a skill (so Tiger Z holds smoothly!)
    if IsUsingOrHoldingSkill() then return end
    if not IsPlayerAlive(LocalPlayer) then return end

    local myChar = GetCharacter(LocalPlayer)
    local myHrp  = GetRootPart(LocalPlayer)
    if not myChar or not myHrp then return end

    local equippedTool = myChar:FindFirstChildOfClass("Tool")
    if not equippedTool then return end

    local bladeHits = {}
    local primaryPart = nil

    if targetPlr and IsPlayerAlive(targetPlr) and GetPlayerPvpState(targetPlr) ~= "Disable Pvp" then
        local tChar = GetCharacter(targetPlr)
        local tHrp  = GetRootPart(targetPlr)
        local tHead = tChar and tChar:FindFirstChild("Head")
        if tChar and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 70 then
            primaryPart = tHrp or tHead
            table.insert(bladeHits, { tChar, primaryPart })
        end
    end

    for _, otherPlr in ipairs(Players:GetPlayers()) do
        if otherPlr ~= LocalPlayer and otherPlr ~= targetPlr and IsPlayerAlive(otherPlr) and GetPlayerPvpState(otherPlr) ~= "Disable Pvp" then
            local oChar = GetCharacter(otherPlr)
            local oHrp  = GetRootPart(otherPlr)
            if oChar and oHrp and (myHrp.Position - oHrp.Position).Magnitude <= 70 then
                primaryPart = primaryPart or oHrp
                table.insert(bladeHits, { oChar, oHrp })
            end
        end
    end

    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, npc in ipairs(enemiesFolder:GetChildren()) do
            local nHum = npc:FindFirstChildOfClass("Humanoid")
            local nHrp = npc:FindFirstChild("HumanoidRootPart")
            if nHum and nHrp and nHum.Health > 0 and (myHrp.Position - nHrp.Position).Magnitude <= 70 then
                primaryPart = primaryPart or nHrp
                table.insert(bladeHits, { npc, nHrp })
            end
        end
    end

    if not primaryPart or #bladeHits == 0 then return end

    -- Layer 1: Blox Fruit M1 LeftClickRemote
    local leftClickRemote = equippedTool:FindFirstChild("LeftClickRemote")
    if leftClickRemote then
        local diff = primaryPart.Position - myHrp.Position
        local dir = (diff.Magnitude > 0.001) and diff.Unit or myHrp.CFrame.LookVector
        State.ComboCounter = (State.ComboCounter % 4) + 1
        pcall(function()
            leftClickRemote:FireServer(dir, State.ComboCounter, true)
        end)
    end

    -- Layer 2: Modules.Net RE/RegisterAttack & RE/RegisterHit
    if not RegisterAttack or not RegisterHit then
        ResolveCombatNet()
    end
    if RegisterAttack and RegisterHit then
        pcall(function()
            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(primaryPart, bladeHits)
        end)
    end

    -- Layer 3: CombatFramework activeController direct fast attack
    local ac = GetCombatActiveController()
    if ac then
        pcall(function()
            ac.timeToNextAttack = 0
            ac.attacking = false
            ac.blocking = false
            ac.increment = 3
            ac.hitboxMagnitude = 70
            if ac.attack then
                ac:attack()
            end
        end)
    end
end

