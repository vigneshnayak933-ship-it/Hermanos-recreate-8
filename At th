-- Pure math helper (Calls ZERO Instance ':Methods()' so L->namecall is NEVER overwritten!)
local function TransformRemoteArguments(remoteName, a1, a2, a3, a4, a5)
    local tPos   = SilentCache.TargetPos
    local oPos   = SilentCache.OriginPos
    local uDir   = SilentCache.UnitDir
    local hitCF  = SilentCache.HitCFrame

    if remoteName == "LeftClickRemote" then
        if typeof(a1) == "Vector3" then
            a1 = uDir
        end
        return a1, a2, a3, a4, a5
    end

    if remoteName == "CommE" then
        if a1 == "MousePos" and typeof(a2) == "Vector3" then
            a2 = tPos
        end
        return a1, a2, a3, a4, a5
    end

    -- Tool RemoteEvent / ShootGunEvent Smart Argument Rewriting
    if a1 == "MousePos" then
        if typeof(a2) == "Vector3" then
            a2 = tPos
        elseif typeof(a2) == "CFrame" then
            a2 = hitCF
        end
        return a1, a2, a3, a4, a5
    end

    -- Rewrite a1 if Vector3 or CFrame
    if typeof(a1) == "Vector3" then
        if a1.Magnitude <= 1.5 then
            a1 = uDir
        else
            a1 = tPos
        end
    elseif typeof(a1) == "CFrame" then
        -- Smart Origin Preservation: If CFrame is near our character, keep its origin and point LookVector at target!
        local p = a1.Position
        if (p - oPos).Magnitude <= 24 and (tPos - p).Magnitude > 0.1 then
            a1 = CFrame.lookAt(p, tPos)
        else
            a1 = hitCF
        end
    end

    -- Rewrite a2 if Vector3 or CFrame (for skills passing (skillName, MousePos) or (OriginCF, TargetPos))
    if typeof(a2) == "Vector3" then
        if a2.Magnitude <= 1.5 then
            a2 = uDir
        else
            a2 = tPos
        end
    elseif typeof(a2) == "CFrame" then
        local p = a2.Position
        if (p - oPos).Magnitude <= 24 and (tPos - p).Magnitude > 0.1 then
            a2 = CFrame.lookAt(p, tPos)
        else
            a2 = hitCF
        end
    end

    return a1, a2, a3, a4, a5
end

local HookingEstablished = false

if hookmetamethod then
    -- 1. Zero-Namecall __namecall Hook (Never invokes any Instance :Method() before oldNamecall!)
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, a1, a2, a3, a4, a5, ...)
            if SilentCache.Active and not checkcaller() then
                local method = getnamecallmethod()
                if method == "FireServer" or method == "InvokeServer" then
                    local rName = self.Name
                    if rName == "RemoteEvent" or rName == "CommE" or rName == "LeftClickRemote" or rName == "ShootGunEvent" then
                        State.LastSkillFireTick = os.clock()
                        a1, a2, a3, a4, a5 = TransformRemoteArguments(rName, a1, a2, a3, a4, a5)
                        if setnamecallmethod then
                            setnamecallmethod(method)
                        end
                        return oldNamecall(self, a1, a2, a3, a4, a5, ...)
                    end
                end
            end
            return oldNamecall(self, a1, a2, a3, a4, a5, ...)
        end))
        HookingEstablished = true
    end)

    -- 2. Zero-Namecall __index Hook for Mouse.Hit, Mouse.Target, and Mouse.UnitRay
    pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if SilentCache.Active and self == Mouse and not checkcaller() then
                if key == "Hit" or key == "hit" then
                    return SilentCache.HitCFrame
                elseif key == "Target" or key == "target" then
                    return SilentCache.AimPart
                elseif key == "UnitRay" or key == "unitRay" then
                    return Ray.new(SilentCache.CameraPos, SilentCache.UnitDir)
                end
            end
            return oldIndex(self, key)
        end))
    end)
end

-- 3. Direct FireServer Function Hook Fallback (If hookmetamethod wasn't used by executor)
if not HookingEstablished and hookfunction then
    pcall(function()
        local dummyRemote = Instance.new("RemoteEvent")
        local oldFireServer
        oldFireServer = hookfunction(dummyRemote.FireServer, newcclosure(function(self, a1, a2, a3, a4, a5, ...)
            if SilentCache.Active and not checkcaller() and typeof(self) == "Instance" then
                local rName = self.Name
                if rName == "RemoteEvent" or rName == "CommE" or rName == "LeftClickRemote" or rName == "ShootGunEvent" then
                    State.LastSkillFireTick = os.clock()
                    a1, a2, a3, a4, a5 = TransformRemoteArguments(rName, a1, a2, a3, a4, a5)
                    return oldFireServer(self, a1, a2, a3, a4, a5, ...)
                end
            end
            return oldFireServer(self, a1, a2, a3, a4, a5, ...)
        end))
        dummyRemote:Destroy()
    end)
end

