        nBody.TextSize = 11
        nBody.TextWrapped = true
        nBody.TextXAlignment = Enum.TextXAlignment.Left
        nBody.ZIndex = 32
        nBody.Parent = notifCard

        task.wait(duration)
        TweenService:Create(notifCard, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(nTitle, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
