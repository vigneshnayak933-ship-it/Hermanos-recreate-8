-- Master SafeZone Detector
local function IsPositionInSafeZone(pos)
    for _, sz in ipairs(KnownSafeZones) do
        local flatDist = Vector2.new(pos.X - sz.Pos.X, pos.Z - sz.Pos.Z).Magnitude
        if flatDist <= sz.Radius and math.abs(pos.Y - sz.Pos.Y) <= 400 then
            return true
        end
    end

    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local safeZones = (worldOrigin and worldOrigin:FindFirstChild("SafeZones")) or Workspace:FindFirstChild("SafeZones")
    if safeZones then
        for _, zone in ipairs(safeZones:GetDescendants()) do
            if zone:IsA("BasePart") then
                local sx, sz = zone.Size.X, zone.Size.Z
                local mesh = zone:FindFirstChildOfClass("DataModelMesh")
                if mesh then
                    sx = math.max(sx, mesh.Scale.X, zone.Size.X * mesh.Scale.X)
                    sz = math.max(sz, mesh.Scale.Z, zone.Size.Z * mesh.Scale.Z)
                end
                local radius = math.clamp(math.max(sx, sz) * 0.52, 25, 600)
                local flatDist = Vector2.new(pos.X - zone.Position.X, pos.Z - zone.Position.Z).Magnitude
                if flatDist <= radius and math.abs(pos.Y - zone.Position.Y) <= 400 then
                    return true
                end
            end
        end
    end

    return false
end

local function GetPlayerPvpState(plr)
    local char = GetCharacter(plr)
    if not char then return "Disable Pvp" end
    if char:FindFirstChildOfClass("ForceField") then
        return "Disable Pvp"
    end
    if char:GetAttribute("PvpDisabled") == true or plr:GetAttribute("PvpDisabled") == true then
        return "Disable Pvp"
    end
    if char:GetAttribute("InSafeZone") == true or plr:GetAttribute("InSafeZone") == true then
        return "Disable Pvp"
    end
    if char:FindFirstChild("InSafeZone") or char:FindFirstChild("SafeZone") or char:FindFirstChild("PvpDisabled") then
        return "Disable Pvp"
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or IsPositionInSafeZone(hrp.Position) then
        return "Disable Pvp"
    end

    if char:GetAttribute("InCombat") == true or plr:GetAttribute("InCombat") == true or char:FindFirstChild("InCombat") then
        return "InCombat"
    end
    return "Ready Pvp"
end

